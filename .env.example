# Derive — every variable is optional; defaults shown. Nothing crashes on missing config.
# GENERATED from apps/api/src/config-manifest.ts; do not edit by hand. Regenerate after a
# change: `pnpm --filter @derive/api gen:env`.

# Where the server listens. 8080 is the conventional self-host/container port (what
# the deploy configs pin). Local `pnpm dev` uses 8090 unless you set PORT here.
PORT=8080

# The public origin used for auth cookies and share links. On Railway/Render/Fly it's
# inferred from the platform's domain; set it explicitly for a custom domain.
BASE_URL=http://localhost:8080

# Default storage: SQLite + local blobs inside one directory.
DATA_DIR=./data

# Where the built web SPA is served from. Default: the client build output next to the
# server. Override only if you relocate the bundle.
# DERIVE_WEB_DIR=/app/apps/web/dist/client

# Optional S3-compatible object storage for blobs (AWS S3, Cloudflare R2, MinIO, GCS).
# Addressing + region auto-pick from the host; TLS on unless tls=false or localhost.
#   AWS:   s3://<key>:<secret>@s3.<region>.amazonaws.com/derive   (region from host)
#   R2:    s3://<key>:<secret>@<account>.r2.cloudflarestorage.com/derive?region=auto
#   MinIO: s3://minioadmin:minioadmin@localhost:9000/derive?region=us-east-1&tls=false
# OBJECT_STORE_URL=s3://ACCESS_KEY:SECRET_KEY@host/bucket?region=auto

# Optional Postgres for metadata instead of the default embedded SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/derive

# Safety gate: pointing DATABASE_URL at a REMOTE host during local `pnpm dev` is blocked
# by default, so a dev machine can't accidentally mutate a production database. Set to 1
# to allow a remote DB in dev. No effect in production.
# DERIVE_ALLOW_REMOTE_DB=1

# The commit this build was cut from. /healthz echoes it as `build`, so "which version is
# actually running" is answerable with curl rather than inferred from a deploy log — a deploy
# can fail while the pipeline around it reads green, and liveness alone cannot tell a fresh
# process from the one already serving. Unset reports "dev". Set it in your image build.
# DERIVE_BUILD_SHA=

# A static bearer token for headless CI/agent writes (and reading gated artifacts).
# Signed-in users can always write; anonymous callers are read-only either way.
# DERIVE_TOKEN=

# --- Analytics, limits & quotas -------------------------------------------

# View analytics (counts, unique viewers, timeline) are on by default. Set false to
# disable recording + the analytics endpoints entirely.
# DERIVE_ANALYTICS=false

# Views are a rolling window; a daily prune drops rows older than this many days.
# Default 365; set 0 to keep everything.
# DERIVE_ANALYTICS_RETENTION_DAYS=365

# How long (in minutes) a burst of consecutive auto-saved versions collapses into one
# display group in the history UI. Unset = built-in default. Storage, @vN URLs, and
# analytics stay at per-version granularity regardless.
# DERIVE_VERSION_WINDOW=30

# Per-IP rate limiting on auth + mutating routes is ON by default; set false to disable
# (e.g. behind your own gateway). Turning it off also disables the per-actor limits below.
# DERIVE_RATE_LIMIT=false

# Reject known-breached passwords at sign-up / reset / change (Have I Been Pwned,
# k-anonymity — the password never leaves the server). ON by default and FAILS OPEN (an
# air-gapped host is never blocked). Set false to disable the check entirely.
# DERIVE_BREACH_CHECK=false

# Per-actor publish limit, actions per minute (signed-in user/agent, falling back to IP).
# Unset = built-in default (30).
# DERIVE_PUBLISH_RATE=30

# Per-actor comment limit, actions per minute. Unset = built-in default (60).
# DERIVE_COMMENT_RATE=60

# Workspace cap on the number of artifacts. Unset = unlimited (self-host stays open).
# Over the cap → 409.
# DERIVE_MAX_ARTIFACTS=1000

# Workspace cap on the summed byte size of all stored versions. Unset = unlimited.
# Over the cap → 413.
# DERIVE_MAX_BYTES=1073741824

# --- Auth (Better Auth) ---------------------------------------------------

# Session-signing secret. Email + password works out of the box; set a real secret in
# production (also encrypts stored third-party credentials at rest).
# DERIVE_AUTH_SECRET=change-me-to-a-long-random-string

# Deprecated migration only: matching verified legacy accounts are bound once to
# immutable user-id operator records. This list never admits account creation.
# DERIVE_SUPERADMIN_EMAILS=you@example.com,ops@example.com

# Account admission: open (anyone), invite (requires a live invitation capability),
# or closed (offline bootstrap only). Existing users can always sign in.
# DERIVE_SIGNUP_MODE=invite

# When the web app is served from a different origin than the API (the hosted split, or
# a reverse proxy), list the web origin(s) here, comma-separated. localhost dev ports
# (3090, 5173) are trusted automatically.
# DERIVE_WEB_ORIGIN=https://app.example.com

# When the SPA and API are on different sites (the hosted split / a CDN front end), the
# session cookie must be SameSite=None; Secure to ride cross-site requests. Pair with
# DERIVE_WEB_ORIGIN. Single-origin self-host leaves this off.
# DERIVE_CROSS_SITE=true

# Passkeys (WebAuthn) turn on wherever the relying-party ID resolves — always for a
# single-origin self-host. For a split SPA+API on different registrable domains, set the
# shared parent domain here to keep passkeys enabled.
# DERIVE_PASSKEY_RPID=example.com

# --- Origin isolation & custom domains ------------------------------------

# Origin isolation (recommended for any instance hosting other people's HTML): serve
# artifact bytes from a SEPARATE registrable domain pointed at this same container, so
# user HTML can never execute on the app's cookie origin. Use a different domain (not a
# subdomain of BASE_URL). Unset = single-origin self-host (the iframe sandbox is the wall).
# DERIVE_SANDBOX_URL=https://usercontent.example.com

# Origin of the public site (marketing pages, blog) for a HOSTED deployment on the
# Node tier: navigations the app does not own are proxied there, and `/` serves its
# landing page to signed-out visitors. derive.to itself runs on Workers and binds the
# site Worker directly (wrangler.toml [[services]] SITE). Unset = the application owns
# the front door, which is right for every self-host.
# DERIVE_SITE_ORIGIN=http://localhost:4321

# Vanity subdomains (domain mode): a base domain whose wildcard (*.<base>) points at this
# server. An artifact assigned `q3-review.<base>` is served at that host's root. Unset =
# subdomain serving off.
# DERIVE_SUBDOMAIN_BASE=derived.app

# Bring-your-own custom domains (Cloudflare for SaaS): let an owner attach their own
# domain to an artifact; CF issues + renews the TLS cert. All three CF_* are required to
# enable; unset = custom domains off (subdomains unaffected). Scoped token: SSL for SaaS /
# custom-hostname edit.
# CF_API_TOKEN=...

# The Cloudflare zone hosting your SaaS fallback origin.
# CF_ZONE_ID=...

# The CNAME target customers point their custom domain at.
# CF_SAAS_FALLBACK_ORIGIN=derive-saas.example.com

# --- Email (verification, password reset, invites) ------------------------

# Transactional email via Resend (over fetch, no SDK). BOTH RESEND_API_KEY and EMAIL_FROM
# must be set to actually send; with neither, Derive logs the message — including reset
# links — instead of sending (the zero-config default), so password reset + email
# verification stay hidden in the UI until configured. (The Cloudflare tier uses its Email
# Service binding instead.)
# RESEND_API_KEY=re_...

# The From address for transactional email.
# EMAIL_FROM=Derive <notifications@your-domain.com>

# --- Sign-in providers (OAuth / SSO) --------------------------------------

# Optional Google sign-in. Callback URL: <BASE_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET=

# Optional GitHub sign-in (distinct from the GitHub integration App). Callback URL:
# <BASE_URL>/api/auth/callback/github
# GITHUB_LOGIN_CLIENT_ID=

# GITHUB_LOGIN_CLIENT_SECRET=

# Optional enterprise SSO via OIDC (Okta, Entra, Auth0, Keycloak, …).
# OIDC_ISSUER=https://your-org.okta.com

# OIDC_CLIENT_ID=

# OIDC_CLIENT_SECRET=

# URL-path id for the provider.
# OIDC_PROVIDER_ID=sso

# Button label shown on the sign-in page for the OIDC provider. Default: "SSO".
# OIDC_PROVIDER_LABEL=Acme SSO

# The GitHub integration is created from Settings → Integrations and stores its
# App credentials encrypted with DERIVE_AUTH_SECRET. It does not use these sign-in vars.

# --- Slack (connect + reply-back) -----------------------------------------

# Slack app credentials — all three are required to enable the Slack integration (connect
# flow + Events API reply-back). Unset = Slack off.
# SLACK_CLIENT_ID=

# SLACK_CLIENT_SECRET=

# SLACK_SIGNING_SECRET=

# --- Semantic search (pgvector) -------------------------------------------

# Turn on dense/semantic search (pgvector) and pick the embedder. `local` runs an in-process
# ONNX model (bge-small, no credentials, downloads ~30 MB on first boot) — the zero-config
# choice. `workersai` calls Cloudflare Workers AI (bge-m3) over REST, which needs
# DERIVE_EMBED_CF_ACCOUNT_ID + DERIVE_EMBED_CF_API_TOKEN below. Either way requires
# DATABASE_URL (Postgres — pgvector lives there); with embedded SQLite it's skipped. Unset =
# lexical-only search. The Cloudflare edge tier uses its Workers AI binding instead of this.
# DERIVE_EMBED_PROVIDER=local

# DERIVE_EMBED_CF_ACCOUNT_ID=

# DERIVE_EMBED_CF_API_TOKEN=

# --- Billing (Stripe) -----------------------------------------------------

# Stripe secret key (sk_test_/sk_live_). Unset disables the billing routes
# entirely; self-host never needs it.
# STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint (whsec_...). Required for
# /v1/billing/webhook to accept events.
# STRIPE_WEBHOOK_SECRET=

# ISO instant after which free-tier boundaries enforce (3 editor seats, 1 GB).
# Unset = beta grace: nothing is blocked and white-label stays free.
# DERIVE_BILLING_ENFORCE_AT=2026-09-01T00:00:00Z

# --- Advanced -------------------------------------------------------------

# The bootstrap workspace id. Auto-generated + persisted beside the data on first run;
# set only to pin a specific id (e.g. to match an existing deployment).
# DERIVE_DEFAULT_ORG_ID=ws_...

# Set to 0 to stop this process running shared background work: webhook delivery,
# the daily prune, and the expired-draft sweep. They are ON by default and a deployment
# should leave them on. This exists for one case — pointing a local process at a REMOTE
# database to reproduce something. Those workers WRITE (the prune and sweep delete rows,
# and the prune fires on boot), so without this a laptop joins that database's worker pool
# the moment it starts.
# DERIVE_BACKGROUND_WORKERS=0

# Render artifact preview screenshots on this Node deploy (needs a Playwright Chromium —
# bundled in the Docker image; on a bare Node host run
# `pnpm --filter @derive/api exec playwright install chromium`). Unset = previews off.
# DERIVE_PREVIEWS=true

# EXPERIMENTAL — hosted automation runs on this Node deploy: the API process materializes
# due schedules and executes each run by spawning the derive CLI
# (`derive runner run <capability token>`) as a child process on this box. Needs the CLI,
# the selected coding agent (Claude Code or Codex), and a matching connected model plan.
# Ambient model keys are deliberately not inherited by the child. Unset = off; queued runs
# then wait for a polling `derive runner`.
# DERIVE_HOSTED_RUNS=true

# Comma-separated immutable workspace ids allowed to execute on this deployment's
# hosted substrate. It gates scheduled materialization, stale-run recovery, the minute dispatch
# sweep, Run now nudges, and hosted ask sessions. Owner-operated polling runners are unaffected.
#
# On the multi-tenant Cloudflare Worker, unset or blank means NOBODY (fail closed). On a Node
# self-host, unset preserves the single-tenant default of no restriction; set it to restrict
# hosted execution there too, and set it to an empty string for a deployment-level stop.
# DERIVE_HOSTED_RUNS_ALLOWLIST=ws_abc123,ws_def456

# EXPERIMENTAL — run hosted automations IN THIS PROCESS instead of spawning the derive CLI.
# A model call plus fetch, which is all a "read something, write an artifact" automation
# needs, with no child process and no container. Anything wanting a shell, a filesystem or
# git still belongs on the CLI runner, so this is opt-in and DERIVE_HOSTED_RUNS must also be
# on. The same code path runs on Cloudflare: the loop is an HTTP client of this API, so
# there is no platform-specific implementation to keep in step.
# DERIVE_LOOP_RUNS=1

# ANTHROPIC model id for in-process runs (DERIVE_LOOP_RUNS) that resolve a per-run model
# plan through the payer chain. Unset = claude-sonnet-5, which is the right default for
# automations: they are latency- and tool-call-bound, so depth buys less than turnaround.
#
# This is NOT DERIVE_MODEL_NAME. That one names the model on your OpenAI-compatible
# gateway and is only meaningful alongside DERIVE_MODEL_BASE_URL; sending it to
# api.anthropic.com returns `model_not_found` on every run. They are separate vars because
# the two ids look interchangeable and are not — passing the gateway's id on the
# credential path is what broke every hosted run before this existed.
# DERIVE_LOOP_MODEL=claude-sonnet-5

# Root of an OPENAI-COMPATIBLE model endpoint (Fireworks, OpenRouter, Together, a
# self-hosted gateway); `/chat/completions` is appended. Setting it points every in-process
# run AND attended chat on this deploy at that endpoint instead of the Anthropic Messages API.
#
# An `openrouter.ai` endpoint also receives Derive's bounded public read tool belt: web search,
# URL fetch, and current date/time. OpenRouter executes those server tools inside the model
# request; other compatible gateways receive only Derive's ordinary function tools.
#
# It BYPASSES THE PAYER CHAIN on purpose: this deployment holds the key and spends it for
# every workspace on it, so there is no chain to walk and no plan for anyone to connect.
# That is the HOSTED posture — derive.to sets all three — and the workspace is metered
# against its tier allowance rather than billed to a credential it never supplied. It is
# equally right for a single-tenant box, where the operator is the only user.
#
# (This entry used to say derive.to does not set it. That was wrong, and it was read as
# intent: the schedule materializer kept walking a payer chain that cannot resolve on a
# hosted deploy, so scheduled automations silently never fired.)
#
# Requires DERIVE_MODEL_API_KEY and DERIVE_MODEL_NAME; all three or none.
# DERIVE_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1

# Bearer token for DERIVE_MODEL_BASE_URL. Read by the API process only and never forwarded
# into a CLI runner's environment, so it cannot redirect a coding agent's credentials.
# DERIVE_MODEL_API_KEY=sk-...

# Comma-separated workspace ids allowed to turn chat on, when DERIVE_MODEL_BASE_URL is set.
#
# Why it exists: `chatBeta` is a workspace setting, gated on `manage` — so on a MULTI-TENANT
# host any workspace owner could enable chat for themselves and spend the operator's model
# key. On a single-tenant box that is fine (the operator IS the user), which is why an unset
# allowlist means no restriction. Set it on a shared host and only those workspaces can
# enable chat, however many owners ask.
# DERIVE_CHAT_ALLOWLIST=ws_abc123,ws_def456

# Model id to send to DERIVE_MODEL_BASE_URL, exactly as that provider names it.
# DERIVE_MODEL_NAME=accounts/fireworks/models/deepseek-v4-flash

# Comma-separated ADDITIONAL model ids the same DERIVE_MODEL_BASE_URL serves, offered to
# chat as a choice alongside DERIVE_MODEL_NAME (which stays the default and is always
# available whether or not it is repeated here).
#
# One gateway serving many models is how every host this reaches works (Fireworks,
# OpenRouter, Together, vLLM), so a second model needs no second key and no second secret
# to rotate. Unset = one model, exactly as before, and the chat picker does not render.
#
# Ids are the provider's own, stored on each answer, so a person can see which model wrote
# what. Removing an id here does not rewrite history: a conversation that used it is told
# the model is gone rather than silently answered by a different one.
#
# THIS IS THE FLOOR, NOT THE WHOLE LIST. An instance operator adds models, renames them,
# pins chat or automations to one, and probes any of them from Settings -> Instance ->
# Models, with no redeploy — same gateway, same key, so a model there is data. Set here
# only what every deployment of this configuration should start with. A genuinely
# different provider needs a key, which only the environment can hold, so that stays a
# deploy. See apps/docs/content/self-hosting/configuration.md, "The model library".
# DERIVE_MODEL_NAMES=accounts/fireworks/models/qwen3-235b,accounts/fireworks/models/kimi-k2

# Preferred upstream backends, best first, comma-separated. Only meaningful on a gateway
# that routes one model id to several of them; unset = the gateway routes as it likes.
# DERIVE_MODEL_PROVIDERS=provider-a,provider-b

# Upstream backends ELIGIBLE for automatic routing, comma-separated. When set, this takes
# precedence over DERIVE_MODEL_PROVIDERS: the gateway chooses among this allowlist using
# current latency, while preferring endpoints sustaining at least 50 output tokens/sec.
# Fallbacks remain enabled, so a rate-limited backend is tried elsewhere automatically.
# Use this instead of a fixed order when availability and interactive speed matter most.
# DERIVE_MODEL_AUTO_PROVIDERS=DeepInfra,DigitalOcean,BaseTen,CoreWeave,Together,Cloudflare

# DEV ONLY — let a workspace with no broker plan use the ECHO stub instead of a broker that
# refuses. The stub's `execute` returns the caller's own arguments: it reaches Stripe, Gmail
# and nothing else, so a run using it reports success over data that never existed and writes
# an artifact full of invented numbers, with no error anywhere. Unset = a workspace with no
# plan gets a refusing broker, which is what you want everywhere a human might see the output.
# MCP connections are unaffected either way — they carry their own server and route on their
# own ref.
# DERIVE_LOCAL_BROKER=1

# Path to the derive CLI the hosted-runs worker spawns (read only when
# DERIVE_HOSTED_RUNS is on). Unset = `derive` on PATH.
# DERIVE_RUNNER_BIN=/usr/local/bin/derive
