# Derive — every variable is optional; defaults shown. Nothing crashes on missing config.

# Where the server listens and how published URLs are built. 8080 is the
# conventional self-host/container port (what the deploy configs pin). Local
# `pnpm dev` defaults to 8090 instead — an uncommon port that rarely collides —
# unless you set PORT here.
PORT=8080
BASE_URL=http://localhost:8080

# Default storage: SQLite + local blobs inside one directory.
DATA_DIR=./data

# Where the built web SPA is served from. Default: the client build output next to the
# server. Override only if you relocate the bundle.
# DERIVE_WEB_DIR=/app/apps/web/dist/client

# Optional: S3-compatible object storage for blobs (AWS S3, Cloudflare R2, MinIO,
# GCS). URL: s3://ACCESS_KEY:SECRET_KEY@host[:port]/bucket?region=...
# Addressing + region auto-pick from the host; TLS on unless tls=false or localhost.
#   AWS:   s3://<key>:<secret>@s3.<region>.amazonaws.com/derive   (region from host)
#   R2:    s3://<key>:<secret>@<account>.r2.cloudflarestorage.com/derive?region=auto
#   MinIO: s3://minioadmin:minioadmin@localhost:9000/derive?region=us-east-1&tls=false
# OBJECT_STORE_URL=

# Optional: Postgres for metadata instead of the default embedded SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/derive

# Safety gate: pointing DATABASE_URL at a REMOTE host during local `pnpm dev` is blocked
# by default, so a dev machine can't accidentally mutate a production database. Set to 1
# to allow a remote DB in dev. No effect in production.
# DERIVE_ALLOW_REMOTE_DB=1

# A static bearer token for headless CI/agent writes (and reading gated artifacts).
# Optional: signed-in users can always write. Anonymous callers are read-only either
# way — there is no "open" mode that makes them owners.
# DERIVE_TOKEN=

# View analytics (counts, unique viewers, timeline, recent viewers) are on by
# default. Set to false to disable recording + the analytics endpoints entirely.
# DERIVE_ANALYTICS=false
# Views are a rolling window; a daily prune drops rows older than this many days
# to keep the table bounded. Default 365; set 0 to keep everything.
# DERIVE_ANALYTICS_RETENTION_DAYS=365

# How long (in minutes) a burst of consecutive auto-saved versions collapses into one
# display group in the history UI. Unset = built-in default. Storage, @vN URLs, and
# analytics stay at per-version granularity regardless.
# DERIVE_VERSION_WINDOW=30

# --- Auth (Better Auth) ---------------------------------------------------
# Email + password works out of the box. Set a real secret in production.
# DERIVE_AUTH_SECRET=change-me-to-a-long-random-string

# Instance operators (super-admins): comma-separated emails that get global powers
# (cross-workspace takedown, the reports/audit queue) on top of the DERIVE_TOKEN bearer.
# DERIVE_SUPERADMIN_EMAILS=you@example.com,ops@example.com

# When the web app is served from a different origin than the API (the hosted
# split, or any reverse proxy), list the web origin(s) here, comma-separated.
# localhost dev ports (3090, 5173) are trusted automatically.
# DERIVE_WEB_ORIGIN=https://app.example.com

# When the SPA and API are on different sites (the hosted split / a CDN front end), the
# session cookie must be SameSite=None; Secure to ride cross-site requests. Pair with
# DERIVE_WEB_ORIGIN. Single-origin self-host leaves this off.
# DERIVE_CROSS_SITE=true

# Passkeys (WebAuthn) turn on wherever the relying-party ID resolves — always for a
# single-origin self-host. For a split SPA+API on different registrable domains, set the
# shared parent domain here to keep passkeys enabled.
# DERIVE_PASSKEY_RPID=example.com

# Origin isolation (recommended for any instance hosting other people's HTML):
# serve artifact bytes from a SEPARATE registrable domain pointed at this same
# container, so user HTML can never execute on the app's cookie origin. Use a
# different domain (not a subdomain of BASE_URL) so session cookies can't reach
# it. Unset = single-origin self-host (the iframe sandbox attribute is the wall).
# DERIVE_SANDBOX_URL=https://usercontent.example.com

# Vanity subdomains (domain mode): a base domain whose wildcard (*.<base>) points
# at this server. An artifact assigned `q3-review.<base>` is then served at that
# host's root — its own origin, a clean URL. Unset = subdomain serving off.
# DERIVE_SUBDOMAIN_BASE=derived.app

# Bring-your-own custom domains (hosted tier): let an owner attach their own domain
# (launch.acme.com) to an artifact. Cloudflare for SaaS issues + renews the TLS cert;
# the customer CNAMEs their domain at CF_SAAS_FALLBACK_ORIGIN. All three are required
# to enable; unset = custom domains disabled (subdomains are unaffected).
# CF_API_TOKEN=...                # scoped token: SSL for SaaS / custom-hostname edit
# CF_ZONE_ID=...                  # the zone hosting your SaaS fallback origin
# CF_SAAS_FALLBACK_ORIGIN=derive-saas.example.com

# --- Email (verification, password reset, invites) ------------------------
# Transactional email via Resend (over fetch, no SDK). BOTH must be set to actually
# send; with neither, Derive logs the message — including reset links — instead of
# sending (the zero-config default), so password reset + email verification stay hidden
# in the UI until configured. (The Cloudflare tier uses its Email Service binding.)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Derive <notifications@your-domain.com>

# --- Abuse limits & quotas ------------------------------------------------
# Per-IP rate limiting on auth + mutating routes is ON by default; set false to
# disable (e.g. behind your own gateway). Turning it off also disables the
# per-actor publish/comment limits below.
# DERIVE_RATE_LIMIT=false
#
# Reject known-breached passwords at sign-up / reset / change (Have I Been Pwned,
# k-anonymity — the password never leaves the server). ON by default and FAILS OPEN
# (if the HIBP API is unreachable, e.g. an air-gapped host, sign-up is never blocked).
# Set false to disable the check entirely.
# DERIVE_BREACH_CHECK=false
#
# Per-actor write limits, in actions per minute (keyed by signed-in user/agent,
# falling back to IP). Unset = built-in defaults (30 publishes, 60 comments).
# DERIVE_PUBLISH_RATE=30
# DERIVE_COMMENT_RATE=60
#
# Workspace storage caps. Unset = unlimited (self-host stays open). maxArtifacts
# caps the number of artifacts; maxBytes caps the summed byte size of all stored
# versions. Over the artifact cap → 409; over the byte cap → 413.
# DERIVE_MAX_ARTIFACTS=1000
# DERIVE_MAX_BYTES=1073741824

# Optional Google sign-in. Callback URL: <BASE_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional GitHub sign-in (a standard GitHub OAuth app — distinct from the
# repo-sync GitHub App, which is created in-app via Settings → GitHub and stored
# in the database, not here). Callback URL: <BASE_URL>/api/auth/callback/github
# GITHUB_LOGIN_CLIENT_ID=
# GITHUB_LOGIN_CLIENT_SECRET=

# GitHub repo sync needs no env: the GitHub App is registered one-click from
# Settings → GitHub (manifest flow) and its credentials are encrypted at rest with
# DERIVE_AUTH_SECRET. (That key must be set for repo sync via the App to work.)

# Optional enterprise SSO via OIDC (Okta, Entra, Auth0, Keycloak, …).
# OIDC_ISSUER=https://your-org.okta.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_ID=sso
# Button label shown on the sign-in page for the OIDC provider. Default: "SSO".
# OIDC_PROVIDER_LABEL=Acme SSO

# --- Slack (connect + reply-back) -----------------------------------------
# Slack app credentials — all three are required to enable the Slack integration
# (connect flow + Events API reply-back). Unset = Slack off.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# --- Advanced -------------------------------------------------------------
# The bootstrap workspace id. Auto-generated + persisted beside the data on first run;
# set only to pin a specific id (e.g. to match an existing deployment).
# DERIVE_DEFAULT_ORG_ID=ws_...
