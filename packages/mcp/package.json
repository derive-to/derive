{
  "name": "@derive-to/mcp",
  "version": "0.5.1",
  "type": "module",
  "description": "Stdio MCP server for Derive — list, read, catch up on, comment on, and publish artifacts on a Derive instance.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "derive",
    "artifacts"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://derive.to",
  "bugs": {
    "url": "https://github.com/derive-to/derive/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/derive-to/derive.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "derive-mcp": "./bin/derive-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "SKILL.md",
    "references"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@derive-to/cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@derive/api": "workspace:*",
    "@derive/core": "workspace:*",
    "@derive/db": "workspace:*",
    "@derive/storage": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@types/node": "^25.9.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
