{
  "name": "@derive-to/cli",
  "version": "0.6.0",
  "type": "module",
  "description": "CLI for Derive \u2014 create projects and publish durable, versioned artifacts from the terminal.",
  "keywords": [
    "derive",
    "ai-agents",
    "artifact-management",
    "document-collaboration",
    "versioned-artifacts",
    "artifacts",
    "publish",
    "cli"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://docs.derive.to/agents/cli/",
  "bugs": {
    "url": "https://github.com/derive-to/derive/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/derive-to/derive.git",
    "directory": "packages/cli"
  },
  "bin": {
    "derive": "./bin/derive.js"
  },
  "exports": {
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.js"
    },
    "./publish": {
      "types": "./src/publish.d.ts",
      "default": "./src/publish.js"
    }
  },
  "files": [
    "bin",
    "src",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "echo 'plain js cli'",
    "typecheck:tsc": "echo 'plain js cli'",
    "test": "vitest run",
    "test:coverage": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
