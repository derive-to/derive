#!/bin/sh
# Pre-push: `pnpm verify:affected` — the guardrails, then typecheck + tests for the
# packages this branch changed (and their dependents) since the merge base with
# origin/main. A branch that only touches apps/web does not wait on the API suite; a
# change to packages/core runs everything downstream of it.
#
# CI always runs the full `pnpm verify` on every push, plus the lanes that need real
# engines (Postgres, D1, workerd) and the image builds. This hook exists to catch the
# common failure before the round trip, not to replace CI.
#
# Enabled automatically via the package.json "prepare" script
# (git config core.hooksPath .githooks) on `pnpm install`.
if ! pnpm verify:affected; then
  echo ""
  echo "✖ pre-push checks failed — CI would fail on this too."
  echo "  Run the failing step alone to iterate:"
  echo "    pnpm run ci        # biome + guardrails (pnpm lint:<name> for one)"
  echo "    pnpm typecheck     # tsgo"
  echo "    pnpm test          # vitest"
  echo "  (Emergency bypass: git push --no-verify)"
  exit 1
fi
