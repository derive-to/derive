#!/bin/sh
# Pre-push: `pnpm verify` — CI's "check" job in full (ci → typecheck →
# test:coverage), in the same order, about 50s.
#
# Pre-commit already covers the first step; the two that only ran in CI were
# typecheck and the per-package coverage ratchet, and those are exactly what a
# green `pnpm test` hides: `test` skips coverage, so a change that drops a
# package under its floor passes locally and fails on push. Catching it here
# costs a minute; catching it in CI costs a round trip and a red commit on the
# branch's history.
#
# Enabled automatically via the package.json "prepare" script
# (git config core.hooksPath .githooks) on `pnpm install`.
if ! pnpm verify; then
  echo ""
  echo "✖ pre-push checks failed — CI would fail on this too."
  echo "  Run the failing step alone to iterate:"
  echo "    pnpm run ci        # biome + guardrails"
  echo "    pnpm typecheck     # tsgo"
  echo "    pnpm test:coverage # tests + the coverage ratchet"
  echo "  (Emergency bypass: git push --no-verify)"
  exit 1
fi
