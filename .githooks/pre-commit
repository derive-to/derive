#!/bin/sh
# Pre-commit: `pnpm run ci`, which is CI's first check step verbatim — biome plus
# every custom guardrail, including knip. It delegates rather than listing the
# checks again, because a hook that keeps its own shorter list drifts from the
# pipeline and then reports green on work CI rejects. ~8s.
#
# The slow half (typecheck + the coverage ratchet) runs in pre-push, where a
# minute is affordable; together the two hooks cover CI's whole `check` job.
#
# Enabled automatically via the package.json "prepare" script
# (git config core.hooksPath .githooks) on `pnpm install`.
if ! pnpm run precommit; then
  echo ""
  echo "✖ pre-commit checks failed. Auto-fix formatting + imports with:"
  echo "    pnpm check:fix"
  echo "then re-stage and commit. (Emergency bypass: git commit --no-verify)"
  exit 1
fi
