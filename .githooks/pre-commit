#!/bin/sh
# Pre-commit: `pnpm run ci` — biome plus every custom guardrail, including knip, run
# concurrently by scripts/guardrails.mjs. It delegates rather than listing the checks
# again, because a hook that keeps its own shorter list drifts from the pipeline and
# then reports green on work CI rejects. About 5s.
#
# Typecheck and tests run in pre-push (see .githooks/pre-push), scoped to the
# packages the branch touched.
#
# Enabled automatically via the package.json "prepare" script
# (git config core.hooksPath .githooks) on `pnpm install`.
if ! pnpm run precommit; then
  echo ""
  echo "✖ pre-commit checks failed. Auto-fix formatting + imports with:"
  echo "    pnpm check:fix"
  echo "then re-stage and commit. (Emergency bypass: git commit --no-verify)"
  exit 1
fi
