{
  "name": "@derive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/derive-to/derive.git",
    "directory": "apps/api"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "build:web": "pnpm --filter @derive/web build && node scripts/prep-edge-assets.mjs",
    "deploy:schema": "node scripts/apply-d1-schema.mjs",
    "migrate:auth": "tsx migrate-auth-d1.ts",
    "deploy": "pnpm build:web && pnpm deploy:schema && tsx migrate-auth-d1.ts --apply && pnpm deploy:pg-schema && wrangler deploy",
    "deploy:pg-schema": "tsx scripts/apply-pg-schema.ts",
    "deploy:smoke": "gh workflow run e2e-smoke.yml --ref main || echo 'post-deploy smoke not triggered (gh CLI unavailable) — run: gh workflow run e2e-smoke.yml'",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.worker.json",
    "typecheck:tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:env": "vitest run test/config-manifest.test.ts -u",
    "gen:openapi": "vitest run test/openapi.test.ts -u"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.19",
    "@better-auth/passkey": "1.6.19",
    "@cloudflare/puppeteer": "^1.0.0",
    "@derive/broker": "workspace:*",
    "@derive/core": "workspace:*",
    "@derive/db": "workspace:*",
    "@derive/storage": "workspace:*",
    "@hono/mcp": "^0.3.0",
    "@hono/node-server": "^2.0.5",
    "@hono/zod-openapi": "1.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@scalar/hono-api-reference": "^0.11.9",
    "better-auth": "^1.6.22",
    "croner": "^10.0.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.1.0",
    "kysely": "^0.29.2",
    "pg": "^8.13.1",
    "playwright": "^1.61.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@derive/hosted-agent": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.11.10",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.40.0"
  }
}
