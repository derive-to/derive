{
  "name": "@dock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Niftory/dock.build.git",
    "directory": "apps/api"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "build:web": "pnpm --filter @dock/web build && node scripts/prep-edge-assets.mjs",
    "deploy": "pnpm build:web && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dock/core": "workspace:*",
    "@dock/db": "workspace:*",
    "@dock/storage": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "better-auth": "^1.6.18",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.6.0",
    "kysely": "^0.29.2",
    "kysely-d1": "^0.4.0",
    "pg": "^8.13.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
