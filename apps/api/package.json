{
  "name": "@dock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Niftory/dock.build.git",
    "directory": "apps/api"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "build:web": "pnpm --filter @dock/web build && node scripts/prep-edge-assets.mjs",
    "deploy:schema": "node scripts/apply-d1-schema.mjs",
    "migrate:auth": "tsx migrate-auth-d1.ts",
    "deploy": "pnpm build:web && pnpm deploy:schema && tsx migrate-auth-d1.ts --apply && wrangler deploy && pnpm deploy:smoke",
    "deploy:smoke": "gh workflow run e2e-smoke.yml --ref main || echo 'post-deploy smoke not triggered (gh CLI unavailable) — run: gh workflow run e2e-smoke.yml'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.19",
    "@dock/core": "workspace:*",
    "@dock/db": "workspace:*",
    "@dock/storage": "workspace:*",
    "@hono/mcp": "^0.3.0",
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "better-auth": "^1.6.19",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "hono-rate-limiter": "^0.5.3",
    "kysely": "^0.29.2",
    "pg": "^8.13.1",
    "zod": "^4.4.3",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.11.10",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.40.0"
  }
}
