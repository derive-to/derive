{
  "name": "@derive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/derive-to/derive.git",
    "directory": "apps/api"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "server": "tsx src/server-cli.ts",
    "build:web": "pnpm --filter @derive/web build && node scripts/prep-edge-assets.mjs",
    "deploy:schema": "node scripts/apply-d1-schema.mjs",
    "migrate:auth": "tsx migrate-auth-d1.ts",
    "deploy": "pnpm build:web && pnpm deploy:schema && tsx migrate-auth-d1.ts --apply && pnpm deploy:pg-schema && wrangler deploy",
    "deploy:pg-schema": "tsx scripts/apply-pg-schema.ts",
    "slack:probe": "tsx scripts/slack-live-probe.ts",
    "deploy:smoke": "gh workflow run e2e-smoke.yml --ref main || echo 'post-deploy smoke not triggered (gh CLI unavailable) — run: gh workflow run e2e-smoke.yml'",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.worker.json",
    "typecheck:tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.manual.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:coverage": "vitest run --coverage",
    "gen:env": "vitest run test/config-manifest.test.ts -u",
    "gen:openapi": "vitest run test/openapi.test.ts -u"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.39",
    "@ai-sdk/openai-compatible": "3.0.30",
    "@better-auth/oauth-provider": "1.6.19",
    "@better-auth/passkey": "1.6.29",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/puppeteer": "^1.3.0",
    "@derive/broker": "workspace:*",
    "@derive/core": "workspace:*",
    "@derive/db": "workspace:*",
    "@derive/storage": "workspace:*",
    "@derive-to/templates": "workspace:*",
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "1.5.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scalar/hono-api-reference": "^0.11.14",
    "ai": "7.0.66",
    "better-auth": "^1.6.29",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.13.2",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.9",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "stripe": "^22.5.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^4.20260615.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "express": "^5.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
