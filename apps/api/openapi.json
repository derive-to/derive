{
  "openapi": "3.0.3",
  "info": {
    "title": "Derive API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Agent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "commenter",
              "editor",
              "owner"
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "created_at"
        ]
      },
      "ConnectedAgent": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grantedAt": {
            "type": "string"
          }
        },
        "required": [
          "clientId",
          "clientName",
          "scopes",
          "grantedAt"
        ]
      },
      "Follow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "org_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "author",
              "path",
              "user"
            ]
          },
          "target": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "handle": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "org_id",
          "user_id",
          "kind",
          "target",
          "created_at"
        ]
      },
      "Collection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "manual",
              "repo",
              "pr"
            ]
          },
          "parentId": {
            "type": "string"
          },
          "prNumber": {
            "type": "number"
          },
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_by",
          "created_at",
          "count"
        ]
      },
      "SlackStatus": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean"
          },
          "team_name": {
            "type": "string",
            "nullable": true
          },
          "default_channel": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "available",
          "connected",
          "team_name",
          "default_channel"
        ]
      },
      "Analytics": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "unique": {
            "type": "number"
          },
          "anonViewers": {
            "type": "number"
          },
          "perVersion": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "number"
                },
                "count": {
                  "type": "number"
                }
              },
              "required": [
                "version",
                "count"
              ]
            }
          },
          "daily": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string"
                },
                "count": {
                  "type": "number"
                }
              },
              "required": [
                "day",
                "count"
              ]
            }
          },
          "recent": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "viewer": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "anon"
                  ]
                },
                "at": {
                  "type": "string"
                },
                "avatar": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "viewer",
                "kind",
                "at"
              ]
            }
          }
        },
        "required": [
          "total",
          "unique",
          "anonViewers",
          "perVersion",
          "daily",
          "recent"
        ]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mention",
              "comment",
              "share",
              "follow",
              "publish",
              "review"
            ]
          },
          "artifact_id": {
            "type": "string"
          },
          "artifact_short_id": {
            "type": "string"
          },
          "artifact_title": {
            "type": "string",
            "nullable": true
          },
          "thread_id": {
            "type": "string"
          },
          "comment_id": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "read": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  1
                ]
              }
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "actor",
          "kind",
          "artifact_id",
          "artifact_short_id",
          "artifact_title",
          "thread_id",
          "comment_id",
          "preview",
          "read",
          "created_at"
        ]
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "generic",
              "slack"
            ]
          },
          "events": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  1
                ]
              }
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "artifact_id",
          "url",
          "kind",
          "events",
          "label",
          "active",
          "created_at"
        ]
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "dead"
            ]
          },
          "attempts": {
            "type": "number"
          },
          "last_error": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "event_type",
          "status",
          "attempts",
          "last_error",
          "created_at"
        ]
      },
      "ArtifactDomain": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "url",
          "kind",
          "status",
          "created_at"
        ]
      },
      "WorkspaceDomain": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DomainDnsRecord"
            }
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "status",
          "created_at"
        ]
      },
      "DomainDnsRecord": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "value"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/agents": {
      "get": {
        "tags": [
          "Agents"
        ],
        "summary": "List the workspace's registered agents (Admin only).",
        "responses": {
          "200": {
            "description": "The workspace's agents.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "agents": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Agent"
                      }
                    }
                  },
                  "required": [
                    "agents"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Agents"
        ],
        "summary": "Register an agent and mint its token (returned once).",
        "responses": {
          "201": {
            "description": "The created agent, plus its bearer token (shown only here).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Agent"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "token"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{id}": {
      "delete": {
        "tags": [
          "Agents"
        ],
        "summary": "Delete an agent (Admin only).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The agent was deleted."
          }
        }
      }
    },
    "/v1/me/connected-agents": {
      "get": {
        "tags": [
          "Agents"
        ],
        "summary": "List the OAuth agents the signed-in user authorized to act on their behalf.",
        "responses": {
          "200": {
            "description": "The caller's connected agents.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "agents": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ConnectedAgent"
                      }
                    }
                  },
                  "required": [
                    "agents"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/connected-agents/{clientId}": {
      "delete": {
        "tags": [
          "Agents"
        ],
        "summary": "Revoke a connected agent's authorization.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "clientId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The grant was revoked (idempotent)."
          }
        }
      }
    },
    "/v1/follows": {
      "get": {
        "tags": [
          "Follows"
        ],
        "summary": "List the signed-in user's follows in their active workspace.",
        "responses": {
          "200": {
            "description": "The caller's follows. People-follows carry the followed person's public handle/name/avatar.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "follows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Follow"
                      }
                    }
                  },
                  "required": [
                    "follows"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Follows"
        ],
        "summary": "Follow a GitHub author, a repo path prefix, or a person.",
        "responses": {
          "201": {
            "description": "The created follow.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "follow": {
                      "$ref": "#/components/schemas/Follow"
                    }
                  },
                  "required": [
                    "follow"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Follows"
        ],
        "summary": "Remove a follow (idempotent).",
        "responses": {
          "204": {
            "description": "The follow was removed."
          }
        }
      }
    },
    "/v1/collections": {
      "get": {
        "tags": [
          "Collections"
        ],
        "summary": "List the active workspace's collections (members only).",
        "responses": {
          "200": {
            "description": "The workspace's collections, each with its item count and origin.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collections": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Collection"
                      }
                    }
                  },
                  "required": [
                    "collections"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Collections"
        ],
        "summary": "Create a collection.",
        "responses": {
          "201": {
            "description": "The created collection (empty, manual).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection"
                }
              }
            }
          }
        }
      }
    },
    "/v1/collections/{id}": {
      "patch": {
        "tags": [
          "Collections"
        ],
        "summary": "Rename a collection.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The updated collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Collections"
        ],
        "summary": "Delete a collection.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The collection was deleted."
          }
        }
      }
    },
    "/v1/collections/{id}/items/{shortId}": {
      "put": {
        "tags": [
          "Collections"
        ],
        "summary": "Add an artifact to a collection.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "shortId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The artifact was added.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Collections"
        ],
        "summary": "Remove an artifact from a collection.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "shortId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The artifact was removed."
          }
        }
      }
    },
    "/v1/slack": {
      "get": {
        "tags": [
          "Slack"
        ],
        "summary": "Slack connection status for the signed-in user's workspace.",
        "responses": {
          "200": {
            "description": "Whether Slack is available + connected, and the team + default channel.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlackStatus"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Slack"
        ],
        "summary": "Set the channel Derive posts to (Admin only).",
        "responses": {
          "200": {
            "description": "The new default channel (or null to clear it).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "default_channel": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "default_channel"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Slack"
        ],
        "summary": "Disconnect Slack from the workspace (Admin only).",
        "responses": {
          "204": {
            "description": "Slack was disconnected."
          }
        }
      }
    },
    "/v1/artifacts/{shortId}/view": {
      "post": {
        "tags": [
          "Analytics"
        ],
        "summary": "Record a view of an artifact (de-duped; owner self-views excluded).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "shortId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Recorded (or skipped as a dup / self-view / disabled)."
          }
        }
      }
    },
    "/v1/artifacts/{shortId}/analytics": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "View stats for an artifact (collaborators only).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "shortId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Totals, per-version + daily counts, and recent distinct viewers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analytics"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List the signed-in user's recent notifications and unread count.",
        "responses": {
          "200": {
            "description": "The 50 most recent notifications and the current unread count.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "notifications": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notification"
                      }
                    },
                    "unread": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "notifications",
                    "unread"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Mark notifications read (all, or a set of ids); returns the new unread count.",
        "responses": {
          "200": {
            "description": "The unread count after marking.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "unread": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "unread"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "List the workspace's webhooks (Admin only).",
        "responses": {
          "200": {
            "description": "The workspace's webhooks, without their signing secrets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhooks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Webhook"
                      }
                    }
                  },
                  "required": [
                    "webhooks"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Create a webhook (Admin only).",
        "responses": {
          "201": {
            "description": "The created webhook, without its signing secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Webhook"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{id}": {
      "delete": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Delete a webhook (Admin only).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The webhook was deleted."
          }
        }
      }
    },
    "/v1/webhooks/{id}/deliveries": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Recent delivery attempts for a webhook (Admin only).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The 20 most recent delivery attempts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deliveries": {
                      "type": "array",
                      "items": {
