{
  "openapi": "3.0.3",
  "info": {
    "title": "Derive API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Follow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "org_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "author",
              "path",
              "user"
            ]
          },
          "target": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "handle": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "org_id",
          "user_id",
          "kind",
          "target",
          "created_at"
        ]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mention",
              "comment",
              "share",
              "follow",
              "publish",
              "review"
            ]
          },
          "artifact_id": {
            "type": "string"
          },
          "artifact_short_id": {
            "type": "string"
          },
          "artifact_title": {
            "type": "string",
            "nullable": true
          },
          "thread_id": {
            "type": "string"
          },
          "comment_id": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "read": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  1
                ]
              }
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "actor",
          "kind",
          "artifact_id",
          "artifact_short_id",
          "artifact_title",
          "thread_id",
          "comment_id",
          "preview",
          "read",
          "created_at"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/follows": {
      "get": {
        "tags": [
          "Follows"
        ],
        "summary": "List the signed-in user's follows in their active workspace.",
        "responses": {
          "200": {
            "description": "The caller's follows. People-follows carry the followed person's public handle/name/avatar.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "follows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Follow"
                      }
                    }
                  },
                  "required": [
                    "follows"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Follows"
        ],
        "summary": "Follow a GitHub author, a repo path prefix, or a person.",
        "responses": {
          "201": {
            "description": "The created follow.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "follow": {
                      "$ref": "#/components/schemas/Follow"
                    }
                  },
                  "required": [
                    "follow"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Follows"
        ],
        "summary": "Remove a follow (idempotent).",
        "responses": {
          "204": {
            "description": "The follow was removed."
          }
        }
      }
    },
    "/v1/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List the signed-in user's recent notifications and unread count.",
        "responses": {
          "200": {
            "description": "The 50 most recent notifications and the current unread count.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "notifications": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notification"
                      }
                    },
                    "unread": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "notifications",
                    "unread"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Mark notifications read (all, or a set of ids); returns the new unread count.",
        "responses": {
          "200": {
            "description": "The unread count after marking.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "unread": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "unread"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
