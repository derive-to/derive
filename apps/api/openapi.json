{
  "openapi": "3.0.3",
  "info": {
    "title": "Derive API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Follow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "org_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "author",
              "path",
              "user"
            ]
          },
          "target": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "handle": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "org_id",
          "user_id",
          "kind",
          "target",
          "created_at"
        ]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mention",
              "comment",
              "share",
              "follow",
              "publish",
              "review"
            ]
          },
          "artifact_id": {
            "type": "string"
          },
          "artifact_short_id": {
            "type": "string"
          },
          "artifact_title": {
            "type": "string",
            "nullable": true
          },
          "thread_id": {
            "type": "string"
          },
          "comment_id": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "read": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  1
                ]
              }
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "actor",
          "kind",
          "artifact_id",
          "artifact_short_id",
          "artifact_title",
          "thread_id",
          "comment_id",
          "preview",
          "read",
          "created_at"
        ]
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "generic",
              "slack"
            ]
          },
          "events": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  1
                ]
              }
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "artifact_id",
          "url",
          "kind",
          "events",
          "label",
          "active",
          "created_at"
        ]
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "dead"
            ]
          },
          "attempts": {
            "type": "number"
          },
          "last_error": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "event_type",
          "status",
          "attempts",
          "last_error",
          "created_at"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/follows": {
      "get": {
        "tags": [
          "Follows"
        ],
        "summary": "List the signed-in user's follows in their active workspace.",
        "responses": {
          "200": {
            "description": "The caller's follows. People-follows carry the followed person's public handle/name/avatar.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "follows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Follow"
                      }
                    }
                  },
                  "required": [
                    "follows"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Follows"
        ],
        "summary": "Follow a GitHub author, a repo path prefix, or a person.",
        "responses": {
          "201": {
            "description": "The created follow.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "follow": {
                      "$ref": "#/components/schemas/Follow"
                    }
                  },
                  "required": [
                    "follow"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Follows"
        ],
        "summary": "Remove a follow (idempotent).",
        "responses": {
          "204": {
            "description": "The follow was removed."
          }
        }
      }
    },
    "/v1/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List the signed-in user's recent notifications and unread count.",
        "responses": {
          "200": {
            "description": "The 50 most recent notifications and the current unread count.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "notifications": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notification"
                      }
                    },
                    "unread": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "notifications",
                    "unread"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Mark notifications read (all, or a set of ids); returns the new unread count.",
        "responses": {
          "200": {
            "description": "The unread count after marking.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "unread": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "unread"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "List the workspace's webhooks (Admin only).",
        "responses": {
          "200": {
            "description": "The workspace's webhooks, without their signing secrets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhooks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Webhook"
                      }
                    }
                  },
                  "required": [
                    "webhooks"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Create a webhook (Admin only).",
        "responses": {
          "201": {
            "description": "The created webhook, without its signing secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Webhook"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{id}": {
      "delete": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Delete a webhook (Admin only).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The webhook was deleted."
          }
        }
      }
    },
    "/v1/webhooks/{id}/deliveries": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Recent delivery attempts for a webhook (Admin only).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The 20 most recent delivery attempts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deliveries": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Delivery"
                      }
                    }
                  },
                  "required": [
                    "deliveries"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{id}/test": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Send a sample event to a webhook so you can confirm it lands (Admin only).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The sample delivery was queued.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "queued": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "queued"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
