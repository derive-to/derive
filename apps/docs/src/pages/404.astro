---
import DocsLayout from "../layouts/DocsLayout.astro"
---

<DocsLayout
  slug="404"
  title="Page not found"
  description="That Derive documentation page does not exist."
  noindex
>
  <div class="not-found" data-pagefind-ignore>
    <span>404 / LOST ARTIFACT</span>
    <h2>This page left no version behind.</h2>
    <p>Check the URL, search the documentation, or return to the start.</p>
    <div>
      <a class="button button-primary" href="/">Documentation home</a>
      <button class="button" type="button" data-search-open>Search documentation</button>
    </div>
  </div>
</DocsLayout>
