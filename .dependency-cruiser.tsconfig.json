{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@derive/core": ["packages/core/src/index.ts"],
      "@derive/core/*": ["packages/core/src/*"],
      "@derive/db": ["packages/db/src/index.ts"],
      "@derive/db/*": ["packages/db/src/*"],
      "@derive/storage": ["packages/storage/src/index.ts"],
      "@derive/storage/*": ["packages/storage/src/*"],
      "@derive-to/mcp": ["packages/mcp/src/index.ts"],
      "@derive-to/mcp/*": ["packages/mcp/src/*"],
      "@derive-to/templates": ["packages/templates/src/index.ts"],
      "@derive-to/templates/*": ["packages/templates/src/*"],
      "@derive/runner": ["packages/runner/src/index.ts"],
      "@derive/runner/*": ["packages/runner/src/*"]
    }
  }
}
