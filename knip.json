{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["gen-auth-schema.ts", "test/e2e/*.mts"]
    },
    "apps/web": {
      "entry": ["src/components/ui/**", "e2e/**/*.screens.ts"]
    },
    "packages/cli": {
      "ignore": ["src/runner.d.ts"]
    },
    "packages/core": {
      "entry": ["src/anchor-client.ts"]
    },
    "packages/data-slots": {
      "ignore": ["examples/**"]
    },
    "packages/db": {
      "ignore": ["test/env.d.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
