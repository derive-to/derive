{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/worker.ts", "gen-auth-schema.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/web": {
      "entry": ["src/components/ui/**"],
      "ignoreDependencies": ["tslib"]
    },
    "packages/db": {
      "ignore": ["test/env.d.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
