{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/selfhost-smoke-client.mjs", "scripts/docs-affected.mjs"]
    },
    "apps/api": {
      "entry": [
        "gen-auth-schema.ts",
        "test/e2e/*.mts",
        "scripts/stripe-seed.mjs",
        "test/**/*.manual.ts",
        "test/weather-mcp-server.mjs"
      ],
      "ignoreDependencies": ["express"]
    },
    "apps/docs": {
      "entry": ["scripts/*.mjs"],
      "ignore": ["content/**"]
    },
    "apps/web": {
      "entry": [
        "src/components/ui/**",
        "e2e/**/*.screens.ts",
        "e2e/public-quality/static-server.mjs",
        "public/site/blog.css",
        "public/site/guides.css",
        "public/site/shell.css",
        "public/site/shell.js"
      ]
    },
    "packages/cli": {
      "ignore": ["src/runner.d.ts"]
    },
    "packages/core": {
      "entry": ["src/anchor-client.ts"]
    },
    "packages/facts": {
      "ignore": ["examples/**"]
    },
    "packages/db": {
      "ignore": ["test/env.d.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
