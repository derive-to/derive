{
  "name": "dock.build",
  "version": "0.1.0",
  "private": true,
  "description": "Manage and share AI artifacts. Self-hostable, CLI-first, with permanent versioned URLs.",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://dock.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/Niftory/dock.build.git"
  },
  "bugs": {
    "url": "https://github.com/Niftory/dock.build/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "esbuild": ">=0.25.0",
      "drizzle-orm": "0.45.2"
    },
    "patchedDependencies": {
      "@better-auth/oauth-provider@1.6.19": "patches/@better-auth__oauth-provider@1.6.19.patch"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @dock/api dev",
    "start": "pnpm --filter @dock/api start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:pg": "bash scripts/test-pg.sh",
    "lint": "biome lint",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:frontend": "node scripts/check-frontend.mjs",
    "lint:testids": "node scripts/check-testids.mjs",
    "lint:api": "node scripts/check-api.mjs",
    "lint:schema": "node scripts/check-schema.mjs",
    "lint:filesize": "node scripts/check-file-size.mjs",
    "lint:bundle": "node scripts/check-bundle.mjs",
    "lint:deadcode": "knip",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "biome ci && pnpm lint:tokens && pnpm lint:frontend && pnpm lint:testids && pnpm lint:api && pnpm lint:schema && pnpm lint:filesize && pnpm lint:deadcode",
    "precommit": "biome check && pnpm lint:tokens && pnpm lint:frontend && pnpm lint:testids && pnpm lint:api && pnpm lint:schema && pnpm lint:filesize",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@vitest/coverage-v8": "^4.1.9",
    "knip": "^6.16.1",
    "typescript": "^6.0.3"
  }
}
