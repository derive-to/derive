{
  "name": "derive.to",
  "version": "0.1.0",
  "private": true,
  "description": "A workspace for agent-made artifacts you can keep, share, and improve. Fair Source, self-hostable, and MCP-native.",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://derive.to",
  "repository": {
    "type": "git",
    "url": "https://github.com/derive-to/derive.git"
  },
  "bugs": {
    "url": "https://github.com/derive-to/derive/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "adm-zip": ">=0.6.0",
      "esbuild": ">=0.25.0",
      "fast-uri": ">=4.1.2",
      "drizzle-orm": "0.45.2",
      "js-yaml": "^4.3.1",
      "sharp": ">=0.35.0",
      "shell-quote": ">=1.9.0",
      "undici": "^7.29.0",
      "ip-address": ">=10.3.1",
      "ws": "^8.21.0",
      "postcss": ">=8.5.23",
      "body-parser": "2.3.0",
      "nanoid@<4": ">=3.3.17",
      "brace-expansion@<2.0.0": "1.1.18",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=3.0.0 <4.0.0": "3.0.6",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "@puppeteer/browsers": "^3.2.0"
    },
    "patchedDependencies": {
      "@better-auth/oauth-provider@1.6.19": "patches/@better-auth__oauth-provider@1.6.19.patch",
      "knip@6.16.1": "patches/knip@6.16.1.patch"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @derive/api dev",
    "dev:web": "pnpm --filter @derive/web dev",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:remote": "bash scripts/dev-remote-db.sh",
    "start": "pnpm --filter @derive/api start",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tsc": "pnpm -r typecheck:tsc",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:pg": "bash scripts/test-pg.sh",
    "lint": "biome lint",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:interaction": "node scripts/check-interaction.mjs",
    "lint:frontend": "node scripts/check-frontend.mjs",
    "lint:mutations": "node scripts/check-mutations.mjs",
    "lint:reload": "node scripts/check-workspace-reload.mjs",
    "lint:surfaces": "node scripts/check-surfaces.mjs",
    "lint:testids": "node scripts/check-testids.mjs",
    "lint:api": "node scripts/check-api.mjs",
    "lint:schema": "node scripts/check-schema.mjs",
    "lint:filesize": "node scripts/check-file-size.mjs",
    "lint:bundle": "node scripts/check-bundle.mjs",
    "lint:anchor-client": "node scripts/check-anchor-client.mjs",
    "lint:deadcode": "knip",
    "build:anchor-client": "node scripts/build-anchor-client.mjs",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "node scripts/guardrails.mjs",
    "verify": "pnpm run ci && pnpm typecheck && pnpm test",
    "precommit": "pnpm run ci",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint:hyperdrive": "node scripts/check-hyperdrive-no-pool.mjs",
    "lint:boundaries": "depcruise --config .dependency-cruiser.mjs packages apps",
    "lint:env": "node scripts/check-env.mjs",
    "lint:api-types": "node scripts/check-api-types.mjs",
    "sync:agent-skill": "node scripts/sync-derive-agent-skill.mjs",
    "lint:agent-skill": "node scripts/sync-derive-agent-skill.mjs --check",
    "lint:agent-package-files": "node scripts/check-agent-package-files.mjs",
    "lint:skills": "node scripts/gen-skills.mjs --check",
    "lint:deck-template": "node scripts/gen-deck-template.mjs --check",
    "lint:app-map": "node scripts/check-app-map.mjs",
    "gen:skills": "node scripts/gen-skills.mjs",
    "gen:worker-types": "node scripts/gen-worker-types.mjs",
    "lint:worker-types": "node scripts/gen-worker-types.mjs --check",
    "gen:deck-template": "node scripts/gen-deck-template.mjs",
    "lint:mcp-coercion": "node scripts/check-mcp-coercion.mjs",
    "lint:local-data": "node scripts/check-local-data.mjs",
    "lint:delete-cascade": "node scripts/check-delete-cascade.mjs",
    "lint:facts-visibility": "node scripts/check-facts-visibility.mjs",
    "lint:facts-portable": "node scripts/check-facts-portable.mjs",
    "lint:derived-exclusion": "node scripts/check-derived-exclusion.mjs",
    "lint:selfhost-quickstart": "node scripts/check-selfhost-quickstart.mjs",
    "lint:deploy-verified": "node scripts/check-deploy-verified.mjs",
    "lint:public-claims": "node scripts/check-public-claims.mjs",
    "lint:workflow-pins": "node scripts/check-workflow-pins.mjs",
    "lint:docs-site": "pnpm --filter @derive/docs build",
    "audit:repository": "node scripts/check-repository-health.mjs",
    "ci:required-checks": "node scripts/set-required-checks.mjs",
    "verify:affected": "sh scripts/verify-affected.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.9",
    "dependency-cruiser": "^18.0.0",
    "esbuild": "0.28.1",
    "knip": "^6.16.1",
    "typescript": "^6.0.3"
  }
}
